import java.util.*;

public class Main {
    public static void main(String[] args) {
        List<Integer> numbers = Arrays.asList(5, -2, 8, -4, 0, 10);

        for (int num : numbers) {
            if (num == 0) {
                break;
            }

            if (num < 0) {
                continue;
            }

            System.out.println(num);
        }
    }
}
